{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/uvicorn.exe",
      "runtimeArgs": ["gemelo.servicio.api:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "dashboard",
      "runtimeExecutable": ".venv/Scripts/streamlit.exe",
      "runtimeArgs": ["run", "src/gemelo/dashboard/app.py", "--server.port", "8501", "--server.headless", "true",
                      "--browser.gatherUsageStats", "false"],
      "port": 8501
    }
  ]
}
