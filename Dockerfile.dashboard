# Imagen del dashboard (Fase 6): solo cliente HTTP de la API (Streamlit + Plotly + httpx).
# No lleva modelos, XGBoost ni SHAP: todo lo calcula el servicio `api`.

FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    GEMELO_API_URL=http://api:8000

WORKDIR /app
COPY pyproject.toml README.md requirements.lock.txt ./
COPY src ./src
RUN pip install -c requirements.lock.txt ".[dashboard]"

RUN useradd --create-home gemelo && chown -R gemelo /app
USER gemelo

EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health')"
CMD ["streamlit", "run", "src/gemelo/dashboard/app.py", "--server.port", "8501", "--server.address", "0.0.0.0", \
     "--server.headless", "true", "--browser.gatherUsageStats", "false"]
